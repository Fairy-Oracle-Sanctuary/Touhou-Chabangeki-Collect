# 复制本文件为 .env.local 并填入真实值
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 登录走 Supabase Auth 的 Custom OIDC Provider（Logto SSO）
# provider 在 Supabase Dashboard → Authentication → Sign In / Providers 配置（custom:logto）
# 前端无需额外配置

# 可选：hCaptcha 人机验证（Supabase Auth → CAPTCHA 开启后填 site key）
# 不填则注册/登录不显示验证码
VITE_HCAPTCHA_SITE_KEY=
